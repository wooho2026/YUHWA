async function goTo(target){

  if(
    transitioning||
    pageTurning||
    coverOpening||
    bookClosing||
    target===currentScreen
  )return;

  if(!$(target))return;

  if(
    (target==="moonrise-screen"||
     target==="night-gallery")&&
    !nightUnlocked
  )return;

  transitioning=true;

  resetPetalAnimations();

  if(document.activeElement instanceof HTMLElement){
    document.activeElement.blur();
  }

  const previous=$(currentScreen);
  const next=$(target);

  previous.classList.add("fading");

  await wait(fadeTime);

  previous.classList.add("hidden");
  previous.classList.remove("fading");

  $("bookCoverButton").classList.remove("opening");

  next.classList.add("fading");
  next.classList.remove("hidden");

  currentScreen=target;

  window.scrollTo(0,0);

  if(target==="album-reader"){
    renderPage();
  }

  if(target==="moonrise-screen"){
    next.classList.remove("reveal");
    void next.offsetWidth;
    next.classList.add("reveal");
  }

  await new Promise(resolve=>
    requestAnimationFrame(resolve)
  );

  next.classList.remove("fading");

  await wait(fadeTime);

  transitioning=false;

}

