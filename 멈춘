const lightbox=$("lightbox");
const lightboxImage=$("lightboxImage");

function activeCollection(){

  if(lightboxMode==="wedding")return creatorWeddingPhotos.map(src=>({src}));
  if(lightboxMode==="magazine")return creatorMagazinePhotos.map(src=>({src}));
  if(lightboxMode==="fantasy")return creatorFantasyPhotos.map(src=>({src}));
  return lightboxMode==="night" ? nightPhotos : photos;

}

function showLightbox(index,mode,allowAll){

  if(
    transitioning||
    pageTurning||
    bookClosing||
    nightChanging
  )return;

  lightboxIndex=index;
  lightboxMode=mode;
  lightboxBrowseAll=allowAll;

  lightboxPreviousFocus=document.activeElement;

  lightbox.classList.remove("hidden");

  document.body.style.overflow="hidden";

  updateLightbox();

  lightbox.querySelector(".lightbox-close").focus();

}

function updateLightbox(){

  const collection=activeCollection();

  loadAsset(
    lightboxImage,
    collection[lightboxIndex].src
  );

  $("lightboxCount").textContent=
    numberFormat(lightboxIndex+1)+
    " / "+numberFormat(collection.length);

  document.querySelectorAll(".lightbox-arrow")
    .forEach(button=>{

      button.classList.toggle(
        "hidden",!lightboxBrowseAll
      );

    });

}

function moveLightbox(direction){

  if(!lightboxBrowseAll)return;

  const length=activeCollection().length;

  lightboxIndex=(
    lightboxIndex+direction+length
  )%length;

  updateLightbox();

}

function closeLightbox(){

  lightbox.classList.add("hidden");

  document.body.style.overflow="";

  if(lightboxImage._cleanup){
    lightboxImage._cleanup();
  }

  lightboxImage.removeAttribute("src");

  if(lightboxPreviousFocus instanceof HTMLElement){
    lightboxPreviousFocus.focus();
  }

}

lightbox.addEventListener("click",event=>{

  if(event.target===lightbox){
    closeLightbox();
  }

});

bindSwipe(lightbox,moveLightbox);

/* ========================================
   키보드 지원
======================================== */

document.addEventListener("keydown",event=>{

  if(!lightbox.classList.contains("hidden")){

    if(event.key==="Escape"){
      closeLightbox();
    }

    if(event.key==="ArrowLeft"){
      event.preventDefault();
      moveLightbox(-1);
    }

    if(event.key==="ArrowRight"){
      event.preventDefault();
      moveLightbox(1);
    }

    if(event.key==="Tab"){

      const controls=[
        ...lightbox.querySelectorAll(
          "button:not(.hidden)"
        )
      ];

      const first=controls[0];
      const last=controls[controls.length-1];

      if(event.shiftKey&&document.activeElement===first){

        event.preventDefault();
        last.focus();

      }else if(
        !event.shiftKey&&document.activeElement===last
      ){

        event.preventDefault();
        first.focus();

      }

    }

    return;

  }

  if(currentScreen==="album-reader"){

    if(event.key==="ArrowLeft"){
      event.preventDefault();
      turnPage(-1);
    }

    if(event.key==="ArrowRight"){
      event.preventDefault();
      turnPage(1);
    }

  }

  if(currentScreen==="night-gallery"){

    if(event.key==="ArrowLeft"){
      event.preventDefault();
      moveNight(-1);
    }

    if(event.key==="ArrowRight"){
      event.preventDefault();
      moveNight(1);
    }

  }

});

</script>

