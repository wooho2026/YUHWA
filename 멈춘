  const right=$("rightPage");
  const spine=spread.querySelector(".book-spine");

  /* 기존 마지막 페이지 그대로 복제 */

  const leaf=document.createElement("div");

  leaf.className="live-closing-leaf";

  const front=right.cloneNode(true);

  front.removeAttribute("id");
  front.removeAttribute("tabindex");
  front.removeAttribute("role");

  front.classList.add("live-closing-front");

  const back=document.createElement("div");

