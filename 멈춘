const nightMain=$("nightMain");

function buildNightFilm(){

  const film=$("nightFilm");

  film.innerHTML="";

  nightPhotos.forEach((photo,index)=>{

    const button=document.createElement("button");

    button.type="button";
    button.className="night-thumb";

    button.setAttribute(
      "aria-label",
      "심야 화보 "+(index+1)
    );

    if(photo.motion){

      const canvas=document.createElement("canvas");
      canvas.width=180;
      canvas.height=240;

      button.appendChild(canvas);

      const still=new Image();

      still.onload=()=>{

        const context=canvas.getContext("2d");

        const scale=Math.max(
          180/still.naturalWidth,
          240/still.naturalHeight
        );

        const w=still.naturalWidth*scale;
        const h=still.naturalHeight*scale;

        context.drawImage(
          still,(180-w)/2,(240-h)/2,w,h
        );

      };

      still.src=imageURL(photo.src);

      const mark=document.createElement("span");
      mark.className="motion-mark";
      mark.textContent="GIF";

      button.appendChild(mark);

    }else{

      const img=document.createElement("img");

      img.alt="심야 화보 "+(index+1);

      loadAsset(img,photo.src);

      button.appendChild(img);

    }

    button.addEventListener("click",()=>{
      selectNight(index);
    });

    film.appendChild(button);

  });

  nightBuilt=true;

}

function updateNightSelection(){

  document.querySelectorAll(".night-thumb")
    .forEach((button,index)=>{

      const active=index===nightIndex;

      button.classList.toggle("selected",active);

      button.setAttribute(
        "aria-pressed",String(active)
      );

    });

  $("nightCaption").textContent=
    nightPhotos[nightIndex].motion
    ?"MOTION PORTRAIT"
    :numberFormat(nightIndex+1)+
     " / "+numberFormat(nightPhotos.length);

}

async function openNightGallery(){

  if(!nightUnlocked||transitioning||bookClosing)return;

  if(!nightBuilt){
    buildNightFilm();
  }

  nightIndex=0;

  loadAsset(nightMain,nightPhotos[0].src);
  updateNightSelection();

  goTo("night-gallery");

}

async function selectNight(index){

  if(
    nightChanging||
    transitioning||
    currentScreen!=="night-gallery"||
    index===nightIndex
  )return;

  if(index<0||index>=nightPhotos.length)return;

  nightChanging=true;

  nightMain.classList.add("fading-out");

  await wait(900);

  const nextImage=new Image();

  const file=nightPhotos[index].src;

  await new Promise(resolve=>{

    let settled=false;

    function finish(){
      if(settled)return;
      settled=true;
      resolve();
    }

    nextImage.onload=finish;
    nextImage.onerror=finish;

    nextImage.src=
      resolvedPhotos.get(file)||imageURL(file);

    setTimeout(finish,3500);

  });

  nightIndex=index;

  loadAsset(nightMain,file);

  updateNightSelection();

  nightMain.classList.remove("fading-out");

  await wait(900);

  nightChanging=false;

}

function moveNight(direction){

  const target=(
    nightIndex+direction+nightPhotos.length
  )%nightPhotos.length;

  selectNight(target);

}

nightMain.addEventListener("click",()=>{

  if(
    nightChanging||
    Date.now()<suppressClickUntil
  )return;

  showLightbox(nightIndex,"night",true);

});

nightMain.addEventListener("keydown",event=>{

  if(event.key==="Enter"||event.key===" "){

    event.preventDefault();

    if(!nightChanging){

