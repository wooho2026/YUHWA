<script>
/* ========================================
   작가의 선물 · 유화의 결혼식
======================================== */

const creatorWeddingPhotos=[
  "merry01.png","merry02.png","merry03.png",
  "merry04.png","merry05.png","merry06.png"
];
let creatorWeddingIndex=0;

function openCreatorWedding(){
  if(transitioning)return;
  creatorWeddingIndex=0;
  renderCreatorWedding();
  goTo("creator-wedding");
}

function moveCreatorWedding(direction){
  if(transitioning)return;
  const count=creatorWeddingPhotos.length;
  creatorWeddingIndex=(creatorWeddingIndex+direction+count)%count;
  renderCreatorWedding();
}

function selectCreatorWedding(index){
  if(transitioning)return;
  if(index===creatorWeddingIndex){
    showLightbox(index,"wedding",true);
    return;
  }
  creatorWeddingIndex=index;
  renderCreatorWedding();
}

function renderCreatorWedding(){
  const stage=$("weddingStage");
  const dots=$("weddingDots");
  const counter=$("weddingCounter");
  if(!stage||!dots||!counter)return;

  const count=creatorWeddingPhotos.length;
  if(stage.children.length!==count){
    stage.replaceChildren();
    dots.replaceChildren();
    creatorWeddingPhotos.forEach((src,index)=>{
      const button=document.createElement("button");
      button.type="button";
      button.className="wedding-photo";
      button.setAttribute("aria-label",`웨딩 사진 ${index+1}`);
      const picture=document.createElement("img");
      picture.alt=`유화의 결혼식 ${index+1}`;
      picture.loading="lazy";
      loadAsset(picture,src);
      button.appendChild(picture);
      button.addEventListener("click",()=>selectCreatorWedding(index));
      stage.appendChild(button);

      const dot=document.createElement("button");
      dot.type="button";
      dot.setAttribute("aria-label",`${index+1}번 웨딩 사진 보기`);
      dot.addEventListener("click",()=>{
        creatorWeddingIndex=index;
        renderCreatorWedding();
      });
      dots.appendChild(dot);
    });
  }

  const mobile=window.innerWidth<=600;
  const shift=mobile?100:190;
  [...stage.children].forEach((photo,index)=>{
    let distance=index-creatorWeddingIndex;
    if(distance>count/2)distance-=count;
    if(distance< -count/2)distance+=count;
    const abs=Math.abs(distance);
    const x=distance*shift;
    const rotate=distance===0?0:(distance<0?36:-36);
    const scale=abs===0?1:abs===1?.78:.58;
    photo.style.transform=`translate(-50%,-50%) translateX(${x}px) rotateY(${rotate}deg) scale(${scale})`;
    photo.style.opacity=abs===0?"1":abs===1?".64":abs===2?".2":"0";
    photo.style.filter=abs===0?"none":"brightness(.7)";
    photo.style.zIndex=String(10-abs);
    photo.style.pointerEvents=abs<=2?"auto":"none";
    photo.classList.toggle("is-center",distance===0);
    photo.setAttribute("aria-hidden",String(abs>2));
    photo.tabIndex=abs<=2?0:-1;
  });
  [...dots.children].forEach((dot,index)=>{
    dot.classList.toggle("active",index===creatorWeddingIndex);
    dot.setAttribute("aria-pressed",String(index===creatorWeddingIndex));
  });
  counter.textContent=numberFormat(creatorWeddingIndex+1)+" / "+numberFormat(count);
}

bindSwipe($("weddingStage"),moveCreatorWedding);
window.addEventListener("resize",()=>{
  if(currentScreen==="creator-wedding")renderCreatorWedding();
});
document.addEventListener("keydown",event=>{
  if(currentScreen!=="creator-wedding"||transitioning||
     !$("lightbox").classList.contains("hidden"))return;
  if(event.key==="ArrowLeft"){
    event.preventDefault();
    moveCreatorWedding(-1);
  }else if(event.key==="ArrowRight"){
    event.preventDefault();
    moveCreatorWedding(1);
  }
});
</script>

