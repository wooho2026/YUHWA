

<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>留華</title>

<link rel="stylesheet"
href="https://cdn.jsdelivr.net/gh/fonts-archive/MaruBuri/MaruBuri.css">

<style>

/* ========================================
   留華 V15.1
======================================== */

:root{
  --bg:#0d0c10;
  --ivory:#eee7dc;
  --muted:#c9beb2;
  --gold:#b99a75;
  --paper:#e9dfce;
  --ink:#51473e;
}

*{box-sizing:border-box}

html,body{
  margin:0;
  min-height:100%;
  background:var(--bg);
}

body{
  color:var(--ivory);
  font-family:"Maru Buri","Malgun Gothic",serif;
}

button{
  font:inherit;
  color:inherit;
  cursor:pointer;
  -webkit-tap-highlight-color:transparent;
}

button:focus-visible,
[role="button"]:focus-visible{
  outline:1px solid #d9b78f;
  outline-offset:5px;
}

img{
  -webkit-user-drag:none;
  user-select:none;
}

.hidden{display:none!important}

/* ========================================
   공통 화면
======================================== */

.screen{
  min-height:100vh;
  min-height:100svh;
  display:flex;
  align-items:center;
  justify-content:center;
  position:relative;
  text-align:center;
  padding:40px 30px;
  overflow:hidden;
  background:radial-gradient(
    ellipse at 50% 40%,
    #292329,
    #0d0c10 75%
  );
  transition:opacity 1.1s ease;
}

.screen::before{
  content:"";
  position:absolute;
  inset:18px;
  border:1px solid #ffffff14;
  pointer-events:none;
}

.screen.fading{
  opacity:0;
  pointer-events:none;
}

.content{
  position:relative;
  width:100%;
  z-index:2;
}

.eyebrow{
  font-family:Arial,sans-serif;
  font-size:10px;
  letter-spacing:5px;
  color:#ad9c89;
}

/* ========================================
   첫 화면
======================================== */

.title-image{
  display:block;
  width:min(250px,62vw);
  height:clamp(230px,43vh,390px);
  object-fit:contain;
  margin:0 auto;
  filter:drop-shadow(0 0 22px #d8bda426);
}

.quote{
  margin-top:28px;
  font-size:14px;
  font-weight:400;
  line-height:1.7;
  color:var(--muted);
  word-break:keep-all;
}

/* ========================================
   흰 꽃 및 꽃잎 8장
======================================== */

.flower-enter{
  display:block;
  position:relative;
  width:150px;
  height:250px;
  margin:6px auto 0;
  padding:0;
  border:0;
  background:transparent;
}

.flower-stage{
  position:absolute;
  display:block;
  width:250px;
  height:250px;
  top:0;
  left:50%;
  transform:translateX(-50%);
  pointer-events:none;
}

.flower-main{
  position:absolute;
  display:block;
  z-index:2;
  width:150px;
  height:150px;
  top:5px;
  left:50%;
  transform:translateX(-50%);
  object-fit:contain;
  filter:drop-shadow(0 0 8px #f5e2ca21);
}

.petals-layer{
  position:absolute;
  inset:0;
  z-index:3;
  pointer-events:none;
}

.falling-petal{
  position:absolute;
  left:50%;
  top:80px;
  width:19px;
  height:34px;
  opacity:0;
  transform-origin:50% 15%;
  pointer-events:none;
}

.falling-petal svg{
  display:block;
  width:100%;
  height:100%;
  overflow:visible;
}

.flower-enter.is-playing .falling-petal,
.closing-petals.is-playing .falling-petal{
  animation:petalFall var(--duration)
  ease-in-out var(--delay) both;
}

@keyframes petalFall{
  0%{
    opacity:0;
    transform:translate(
      var(--start-x),var(--start-y)
    ) rotate(var(--start-rotate)) scale(.85);
  }
  12%{opacity:1}
  30%{
    opacity:.95;
    transform:translate(
      calc(var(--start-x) + var(--sway)),
      calc(var(--start-y) + 35px)
    ) rotate(45deg);
  }
  60%{
    opacity:.85;
    transform:translate(
      calc(var(--start-x) - var(--sway)),
      calc(var(--start-y) + 85px)
    ) rotate(125deg) scale(.9);
  }
  85%{opacity:.5}
  100%{
    opacity:0;
    transform:translate(
      calc(var(--start-x) + var(--drift)),
      calc(var(--start-y) + var(--fall))
    ) rotate(var(--end-rotate)) scale(.7);
  }
}

/* ========================================
   기록 보관소
======================================== */

.archive-content{
  max-width:850px;
  margin:0 auto;
}

.archive-title-image{
  display:block;
  width:150px;
  height:175px;
  object-fit:contain;
  margin:0 auto;
  filter:drop-shadow(0 0 14px #d8bda41e);
}

.archive-eyebrow{
  margin-top:15px;
  margin-bottom:30px;
  font-size:10px;
  letter-spacing:5px;
  line-height:1.6;
}

.cards{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:16.8px;
  width:100%;
  max-width:456px;
  margin:25px auto 0;
}

.card{
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  position:relative;
  min-width:0;
  min-height:190px;
  padding:15px 0;
  border:0;
  background:transparent;
  text-align:center;
}

.menu-symbol{
  display:block;
  width:112px;
  height:112px;
  max-width:100%;
  object-fit:contain;
  margin:0 auto 14px;
  opacity:.88;
  transition:opacity .7s,filter .7s;
}

.card:hover .menu-symbol,
.card:focus-visible .menu-symbol{
  opacity:1;
  filter:drop-shadow(0 0 17px #f7e3c973);
}

.card small{
  font-family:Arial,sans-serif;
  font-size:10px;
  letter-spacing:2px;
  color:#bba992;
  white-space:nowrap;
  transition:color .5s;
}

.card p{
  margin:12px 0 0;
  font-size:15px;
  color:#e7dad0;
  transition:color .5s,text-shadow .5s;
}

.card:hover small{color:#e1c7a5}

.card:hover p{
  color:#fff3e2;
  text-shadow:0 0 12px #e7d3b94d;
}

#archive .flower-enter{
  margin:25px auto 0;
}

/* ========================================
   사진첩 앞표지
======================================== */

.album-cover-content{
  max-width:800px;
  margin:auto;
}

.cover-eyebrow{margin-bottom:30px}

.album-heading{
  margin:15px 0 30px;
  font-weight:400;
  font-size:21px;
  letter-spacing:3px;
}

.book-cover-button{
  display:block;
  position:relative;
  width:min(340px,72vw);
  aspect-ratio:471/564;
  margin:0 auto;
  padding:0;
  border:0;
  background:transparent;
  perspective:1300px;
  isolation:isolate;
}

.cover-paper-edges{
  position:absolute;
  inset:5px 6px 5px 11px;
  border-radius:4px 9px 9px 4px;
  background:repeating-linear-gradient(
    0deg,
    #d5c7ae 0px,
    #e6dac6 2px,
    #bba98e 3px,
    #eadfcb 4px
  );
  box-shadow:0 12px 25px #0006;
}

.cover-inner-paper{
  position:absolute;
  inset:9px 9px 9px 16px;
  border-radius:2px 5px 5px 2px;
  background:linear-gradient(
    90deg,#b4a289,#e7dcc8 9%,
    #f0e6d5 85%,#decfb6
  );
  border:1px solid #bba88c;
  overflow:hidden;
  pointer-events:none;
}

.cover-leaf{
  position:absolute;
  inset:0;
  z-index:3;
  transform-origin:left center;
  transform-style:preserve-3d;
  transition:transform .7s cubic-bezier(.22,.7,.25,1);
}

.book-cover-image{
  position:absolute;
  inset:0;
  display:block;
  width:100%;
  height:100%;
  object-fit:fill;
  backface-visibility:hidden;
  filter:drop-shadow(0 12px 18px #0006);
}

.cover-leaf-back{
  position:absolute;
  inset:5px;
  border-radius:4px;
  backface-visibility:hidden;
  transform:rotateY(180deg);
  background:linear-gradient(
    90deg,#bcaa8e,#e4d8c2 12%,
    #eee3d0 90%,#bfad92
  );
}

@media(hover:hover) and (pointer:fine){
  .book-cover-button:not(.opening):hover .cover-leaf{
    transform:rotateY(-23deg);
  }
}

.book-cover-button:not(.opening):focus-visible .cover-leaf{
  transform:rotateY(-23deg);
}

.book-cover-button.opening .cover-leaf{
  transform:rotateY(-155deg);
  transition:transform 1s cubic-bezier(.35,.08,.25,1);
}

.cover-hint{
  margin-top:22px;
  font-size:12px;
  color:#a89989;
  letter-spacing:1px;
}

/* ========================================
   사진첩 내부
======================================== */

.reader-content{
  max-width:1120px;
  margin:0 auto;
}

.reader-header{margin-bottom:26px}

.book{
  position:relative;
  width:min(960px,100%);
  aspect-ratio:1.65;
  margin:0 auto;
  padding:9px;
  perspective:1800px;
  background:#292521;
  border-radius:6px 10px 10px 6px;
  box-shadow:
    0 25px 65px #0008,
    0 4px 0 #82715c,
    0 7px 0 #55483b;
  touch-action:pan-y;
}

.book-spread{
  display:grid;
  grid-template-columns:1fr 1fr;
  position:relative;
  width:100%;
  height:100%;
  perspective:1800px;
}

.page{
  position:relative;
  width:100%;
  height:100%;
  min-width:0;
  min-height:0;
  overflow:hidden;
  color:var(--ink);
  background:var(--paper);
  cursor:pointer;
}

.page-left{
  background:linear-gradient(
    90deg,#e1d3bd,#eee5d5 5%,
    #ede3d2 90%,#cabcaa
  );
  border-radius:2px 0 0 2px;
}

.page-right{
  background:linear-gradient(
    90deg,#cabcaa,#eee5d5 10%,
    #f1e8da 95%,#decfb9
  );
  border-radius:0 4px 4px 0;
}

.page::after{
  content:"";
  position:absolute;
  inset:5%;
  border:1px solid #80694b21;
  pointer-events:none;
}

.book-spine{
  position:absolute;
  z-index:5;
  top:0;
  bottom:0;
  left:50%;
  width:24px;
  transform:translateX(-50%);
  background:linear-gradient(
    90deg,transparent,#59473730,
    #47372750,#59473720,transparent
  );
  pointer-events:none;
}

/* ========================================
   사진 자체를 클릭하여 확대
======================================== */

.photo-frame{
  position:absolute;
  top:8%;
  right:9%;
  bottom:12%;
  left:9%;
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
}

.album-photo{
  display:block;
  width:auto;
  height:auto;
  max-width:100%;
  max-height:100%;
  object-fit:contain;
  cursor:zoom-in;
  transition:filter .6s ease;
}

.album-photo:hover{
  filter:brightness(1.045);
}

.photo-number{
  position:absolute;
  left:0;
  right:0;
  bottom:5%;
  font-family:Arial,sans-serif;
  font-size:9px;
  letter-spacing:3px;
  color:#8e7e69;
}

/* ========================================
   유화의 대사
======================================== */

.page-writing{
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  height:100%;
  padding:9%;
}

.chapter-number{
  font-family:Arial,sans-serif;
  font-size:9px;
  letter-spacing:3px;
  color:#9a846b;
}

.page-decoration{
  font-size:25px;
  color:#aa9378;
  margin:20px 0;
}

.photo-quote{
  width:100%;
  font-size:clamp(12px,1.7vw,19px);
  font-weight:400;
  line-height:1.5;
  word-break:keep-all;
  overflow-wrap:break-word;
  white-space:pre-line;
  text-wrap:pretty;
  color:#52463c;
}

/* ========================================
   V15.1 마지막 페이지
   로고 삭제 / 진한 텍스트 버튼
======================================== */

.moon-seal-button{
  display:block;
  margin:24px auto 0;
  padding:3px 0;
  border:0;
  background:transparent;
  color:#49372b;
  cursor:pointer;
  animation:sealAppear 1.5s ease both;
}

.moon-seal-label{
  display:block;
  font-size:16px;
  font-weight:700;
  letter-spacing:.5px;
  line-height:1.5;
  color:#49372b;
  transition:color .5s,text-shadow .5s;
}

.moon-seal-button:hover .moon-seal-label{
  color:#261a14;
  text-shadow:0 0 8px #ffffff99;
}

.final-page-hint{
  position:static;
  margin:9px auto 0;
  font-size:12px;
  font-weight:500;
  line-height:1.5;
  color:#49372b;
  letter-spacing:.2px;
  word-break:keep-all;
}

@keyframes sealAppear{
  from{opacity:0;transform:translateY(5px)}
  to{opacity:1;transform:translateY(0)}
}

/* ========================================
   입체적인 책장 넘김
======================================== */

.flip-sheet{
  position:absolute;
  z-index:20;
  top:0;
  width:50%;
  height:100%;
  transform-style:preserve-3d;
  pointer-events:none;
}

.flip-sheet.forward{
  left:50%;
  transform-origin:left center;
  animation:turnForward .9s
  cubic-bezier(.35,.08,.25,1) forwards;
}

.flip-sheet.backward{
  left:0;
  transform-origin:right center;
  animation:turnBackward .9s
  cubic-bezier(.35,.08,.25,1) forwards;
}

.flip-face{
  position:absolute;
  inset:0;
  backface-visibility:hidden;
  overflow:hidden;
  box-shadow:8px 2px 20px #0002;
}

.flip-back{transform:rotateY(180deg)}

@keyframes turnForward{
  from{transform:rotateY(0deg)}
  to{transform:rotateY(-180deg)}
}

@keyframes turnBackward{
  from{transform:rotateY(0deg)}
  to{transform:rotateY(180deg)}
}

.reader-footer{margin-top:24px}

.page-counter{
  font-family:Arial,sans-serif;
  font-size:11px;
  letter-spacing:4px;
  color:#c1ad96;
}

.reader-hint{
  margin-top:13px;
  font-size:11px;
  color:#8c8076;
}

/* ========================================
   일반 사진 전체 보기
======================================== */

.gallery-content{
  max-width:1000px;
  margin:0 auto;
}

.gallery{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:16px;
  margin:35px auto 0;
}

.gallery-item{
  display:block;
  position:relative;
  padding:0;
  border:0;
  background:#ffffff04;
  overflow:hidden;
  aspect-ratio:3/4;
}

.gallery-item img{
  display:block;
  width:100%;
  height:100%;
  object-fit:cover;
  transition:filter .5s,transform .7s;
}

.gallery-item:hover img{
  transform:scale(1.035);
  filter:brightness(1.08);
}

.gallery-index{
  position:absolute;
  bottom:10px;
  left:12px;
  font-family:Arial,sans-serif;
  font-size:10px;
  letter-spacing:2px;
  color:#fff;
  text-shadow:0 1px 7px #000;
}

/* ========================================
   책 닫힘 애니메이션
   V15.1 뒷표지 적용
======================================== */

.closing-overlay{
  position:fixed;
  inset:0;
  z-index:900;
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
  background:radial-gradient(
    ellipse at center,#292329,#100d13 78%
  );
  opacity:0;
  transition:opacity 1.5s ease;
}

.closing-overlay.visible{opacity:1}

.closing-composition{
  width:min(740px,86vw);
  aspect-ratio:1.65;
  position:relative;
  perspective:1700px;
  transition:opacity 1.5s ease;
}

.closing-base{
  position:absolute;
  inset:0;
  display:grid;
  grid-template-columns:1fr 1fr;
  padding:6px;
  background:#302921;
  border-radius:6px;
  box-shadow:0 20px 50px #0008;
}

.closing-page{
  background:linear-gradient(
    90deg,#e8dcc7,#f0e6d6 90%,#c4b297
  );
  overflow:hidden;
  display:flex;
  align-items:center;
  justify-content:center;
}

.closing-page img{
  width:85%;
  height:85%;
  object-fit:contain;
}

.closing-page p{
  color:#655241;
  font-size:clamp(10px,1.7vw,17px);
  padding:10%;
  text-align:center;
  line-height:1.5;
}

.closing-leaf{
  position:absolute;
  left:0;
  top:0;
  width:50%;
  height:100%;
  z-index:3;
  transform-origin:right center;
  transform-style:preserve-3d;
}

.closing-leaf-front,
.closing-leaf-back{
  position:absolute;
  inset:0;
  backface-visibility:hidden;
}

.closing-leaf-front{
  background:#eee3d1;
  display:grid;
  place-items:center;
}

.closing-leaf-front img{
  width:85%;
  height:85%;
  object-fit:contain;
}

.closing-leaf-back{
  transform:rotateY(180deg);
  background:#292521;
}

.closing-leaf-back img{
  width:100%;
  height:100%;
  object-fit:fill;
}

.closing-composition.fold .closing-leaf{
  animation:closeBook 1.5s
  cubic-bezier(.3,.1,.25,1) forwards;
}

.closing-composition.fold .closing-base{
  animation:hideLeftBook 1.5s forwards;
}

@keyframes closeBook{
  from{transform:rotateY(0deg)}
  to{transform:rotateY(180deg)}
}

@keyframes hideLeftBook{
  0%,30%{clip-path:inset(0 0 0 0)}
  100%{clip-path:inset(0 0 0 50%)}
}

.closed-cover-final{
  position:absolute;
  left:50%;
  top:50%;
  width:min(290px,58vw);
  aspect-ratio:2/3;
  transform:translate(-50%,-50%);
  object-fit:contain;
  opacity:0;
  transition:opacity .8s ease;
  filter:drop-shadow(0 10px 25px #0008);
}

.closed-cover-final.visible{opacity:1}

.closing-petals{
  position:absolute;
  z-index:6;
  left:50%;
  top:47%;
  width:300px;
  height:300px;
  transform:translate(-50%,-50%);
  pointer-events:none;
}

.closing-petals .falling-petal{
  width:24px;
  height:42px;
}

.closing-overlay.dissolve .closed-cover-final{
  opacity:0;
  transition:opacity 1.5s ease;
}

/* ========================================
   달이 깊어지면 : 입구
======================================== */

#moonrise-screen,
#night-gallery{
  background:radial-gradient(
    ellipse at 50% 45%,
    #33242f 0%,
    #1c151e 45%,
    #100d13 85%
  );
}

#moonrise-screen::before,
#night-gallery::before{
  border:0;
}

.moonrise-content{
  max-width:650px;
  margin:auto;
}

.moonrise-button{
  display:block;
  position:relative;
  width:min(410px,80vw);
  margin:auto;
  padding:0;
  border:0;
  background:transparent;
  isolation:isolate;
}

.moonrise-button::before{
  content:"";
  position:absolute;
  z-index:-1;
  inset:-20%;
  background:radial-gradient(
    ellipse,#d5bba52a,transparent 66%
  );
  opacity:.5;
  transition:opacity 1s;
  pointer-events:none;
}

.moonrise-logo{
  display:block;
  width:100%;
  height:auto;
  object-fit:contain;
  filter:drop-shadow(0 0 12px #e5cdb426);
  transition:filter 1s ease;
}

.moonrise-button:hover::before{opacity:1}

.moonrise-button:hover .moonrise-logo{
  filter:drop-shadow(0 0 24px #e5cdb454);
}

#moonrise-screen.reveal .moonrise-button{
  animation:moonriseReveal 2s ease both;
}

@keyframes moonriseReveal{
  from{
    opacity:0;
    transform:translateY(12px);
    filter:brightness(.5);
  }
  to{
    opacity:1;
    transform:translateY(0);
    filter:brightness(1);
  }
}

/* ========================================
   심야 전시실
======================================== */

.night-content{
  width:min(820px,100%);
  margin:auto;
}

.night-heading{
  font-family:Arial,sans-serif;
  font-size:9px;
  letter-spacing:6px;
  color:#b69aa9;
  margin-bottom:25px;
}

.night-stage{
  position:relative;
  width:100%;
  height:clamp(300px,64vh,700px);
  display:flex;
  align-items:center;
  justify-content:center;
  touch-action:pan-y;
}

.night-main{
  position:absolute;
  display:block;
  max-width:100%;
  max-height:100%;
  width:auto;
  height:auto;
  object-fit:contain;
  cursor:zoom-in;
  box-shadow:0 12px 45px #0004;
  opacity:1;
  transition:opacity .9s ease;
}

.night-main.fading-out{opacity:0}

.night-arrow{
  position:absolute;
  top:50%;
  transform:translateY(-50%);
  z-index:5;
  border:0;
  background:transparent;
  font-size:30px;
  color:#b9a1af;
  opacity:.45;
  padding:12px;
  transition:opacity .5s;
}

.night-arrow:hover{opacity:1}

.night-prev{left:0}
.night-next{right:0}

