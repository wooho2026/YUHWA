<script>
/* 유화 목소리 : 오디오 플레이어 동작 */
(function(){
  const cards=Array.from(document.querySelectorAll('#voice .voice-card'));
  let activeAudio=null;

  function formatVoiceTime(seconds){
    if(!Number.isFinite(seconds)||seconds<0)return '--:--';
    const n=Math.floor(seconds);
    return String(Math.floor(n/60)).padStart(2,'0')+':'+String(n%60).padStart(2,'0');
  }

  function updateVoiceCard(card){
    const audio=card.querySelector('audio');
    const duration=audio.duration;
    const current=audio.currentTime||0;
    const playing=!audio.paused&&!audio.ended;
    const seek=card.querySelector('.voice-seek');
    const progress=(Number.isFinite(duration)&&duration>0)?current/duration:0;
    seek.value=String(Math.round(progress*1000));
    seek.style.setProperty('--voice-progress',(progress*100)+'%');
    card.querySelector('.voice-elapsed').textContent=formatVoiceTime(current);
    card.querySelector('.voice-duration').textContent=formatVoiceTime(duration);
    card.classList.toggle('is-playing',playing);
    const play=card.querySelector('.voice-play');
    play.setAttribute('aria-pressed',String(playing));
    play.setAttribute('aria-label',card.dataset.voice+'번 녹음 '+(playing?'일시정지':'재생'));
    card.querySelector('.voice-play-icon').textContent=playing?'Ⅱ':'▶';
  }

  cards.forEach(card=>{
    const audio=card.querySelector('audio');
    const button=card.querySelector('.voice-play');
    const seek=card.querySelector('.voice-seek');

    button.addEventListener('click',async()=>{
      if(!audio.paused){
        audio.pause();
        return;
      }
      cards.forEach(other=>{
        const previous=other.querySelector('audio');
        if(previous!==audio)previous.pause();
      });
      activeAudio=audio;
      try{await audio.play();}
      catch(error){
        console.warn('목소리 재생 실패:',audio.getAttribute('src'),error);
        updateVoiceCard(card);
      }
    });

    seek.addEventListener('input',()=>{
      if(Number.isFinite(audio.duration)&&audio.duration>0){
        audio.currentTime=Number(seek.value)/1000*audio.duration;
      }
      updateVoiceCard(card);
    });

    ['loadedmetadata','durationchange','timeupdate','play','pause','ended','seeked'].forEach(type=>{
      audio.addEventListener(type,()=>updateVoiceCard(card));
    });
    audio.addEventListener('error',()=>{
      console.warn('MP3 파일 경로 확인:',audio.getAttribute('src'));
    });

    const details=card.querySelector('.voice-details');
    details.addEventListener('toggle',()=>{
      card.classList.toggle('transcript-open',details.open);
      details.querySelector('summary').textContent=details.open?'대사 접기':'대사 전문 펼치기';
    });

    card.classList.toggle('transcript-open',details.open);
    updateVoiceCard(card);
  });

  const voiceScreen=document.getElementById('voice');
  const observer=new MutationObserver(()=>{
    if(voiceScreen.classList.contains('hidden')||voiceScreen.classList.contains('fading')){
      cards.forEach(card=>card.querySelector('audio').pause());
      activeAudio=null;
    }
  });
  observer.observe(voiceScreen,{attributes:true,attributeFilter:['class']});

  document.addEventListener('visibilitychange',()=>{
    if(document.hidden&&activeAudio&&!activeAudio.paused)activeAudio.pause();
  });
})();
</script>
</body>
</html>
