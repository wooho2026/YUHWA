async function closeBookAndRevealMoon(){

  if(
    bookClosing||
    transitioning||
    !albumCompleted
  )return;

  bookClosing=true;

  resetPetalAnimations();

  const overlay=$("closingOverlay");
  const composition=$("closingComposition");
  const closedCover=$("closedCoverFinal");
  const petals=$("closingPetals");

  composition.classList.remove("fold");
  composition.style.opacity="1";

  closedCover.classList.remove("visible");
  petals.classList.remove("is-playing");

  overlay.classList.remove("dissolve","visible");

  loadAsset(
    $("closingPhoto"),
    photos[photos.length-1].src
  );

  loadAsset(
    $("closingLeafPhoto"),
    photos[photos.length-1].src
  );

  overlay.classList.remove("hidden");

  await new Promise(resolve=>
    requestAnimationFrame(resolve)
  );

  overlay.classList.add("visible");

  await wait(600);

  composition.classList.add("fold");

  await wait(1500);

  closedCover.classList.add("visible");

  composition.style.opacity="0";

  await wait(800);

  petals.classList.add("is-playing");

  await wait(3000);

  overlay.classList.add("dissolve");

  await wait(1500);

  nightUnlocked=true;

  $("album-reader").classList.add("hidden");

  const moonScreen=$("moonrise-screen");

  moonScreen.classList.remove("hidden");
  moonScreen.classList.remove("reveal");

  currentScreen="moonrise-screen";

  window.scrollTo(0,0);

  overlay.classList.remove("visible");

  void moonScreen.offsetWidth;

  moonScreen.classList.add("reveal");

  await wait(1500);

  overlay.classList.add("hidden");

  petals.classList.remove("is-playing");

  bookClosing=false;

}

