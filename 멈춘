  reader.classList.add("closing-live-screen");

  book.classList.add("closing-live");

  right.style.visibility="hidden";

  await new Promise(resolve=>
    requestAnimationFrame(()=>{
      requestAnimationFrame(resolve);
    })
  );

  /* 우측 페이지가 좌측으로 넘어감 */

  leaf.classList.add("is-closed");

  await wait(1500);

  /* 완전히 닫힌 뒷표지 */

  const closedBook=document.createElement("img");

  closedBook.className="live-closed-book";

  closedBook.src="book%20end.png";

