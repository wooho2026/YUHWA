  creatorFantasyIndex=0;
  stage.replaceChildren(makeCreatorFantasySlide(0));
  updateCreatorFantasyCounter();
  creatorFantasyBuilt=true;
}

async function moveCreatorFantasy(direction){
  if(creatorFantasyMoving||transitioning||currentScreen!=="creator-fantasy"||
     !$("lightbox").classList.contains("hidden"))return;
  creatorFantasyMoving=true;
  const stage=$("fantasyStage");
  const outgoing=stage.firstElementChild;
  const next=(creatorFantasyIndex+direction+creatorFantasyPhotos.length)%creatorFantasyPhotos.length;
  const incoming=makeCreatorFantasySlide(next);
  incoming.style.transform=`translateX(${direction>0?100:-100}%)`;
  stage.appendChild(incoming);

  if(motionReduced){
    outgoing.remove();
    incoming.style.transform="translateX(0)";
  }else{
    await new Promise(resolve=>requestAnimationFrame(()=>requestAnimationFrame(resolve)));
    outgoing.style.transform=`translateX(${direction>0?-100:100}%)`;
    incoming.style.transform="translateX(0)";
    await wait(850);
    outgoing.remove();
  }
  creatorFantasyIndex=next;
  updateCreatorFantasyCounter();
  creatorFantasyMoving=false;
}

