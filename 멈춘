/* ========================================
   입체적인 페이지 전환
======================================== */

function turnPage(direction){

  if(
    transitioning||pageTurning||
    coverOpening||bookClosing||
    currentScreen!=="album-reader"||
    !$("lightbox").classList.contains("hidden")
  )return;

  if(
    currentPage===photos.length-1&&
    direction===1
  ){

    if(albumCompleted){
      closeBookAndRevealMoon();
    }

    return;

  }

  const next=currentPage+direction;

  if(next<0||next>=photos.length)return;

  if(motionReduced){

    currentPage=next;
    renderPage();
    return;

  }

  pageTurning=true;

  const sheet=document.createElement("div");
  const front=document.createElement("div");
  const back=document.createElement("div");

  sheet.className="flip-sheet "+
    (direction===1?"forward":"backward");

  if(direction===1){

    front.className="flip-face page page-right";
    back.className="flip-face flip-back page page-left";

    fillRightPage(front,currentPage,false);
    fillLeftPage(back,next,false);
    fillRightPage(rightPage,next,false);

  }else{

    front.className="flip-face page page-left";
    back.className="flip-face flip-back page page-right";

    fillLeftPage(front,currentPage,false);
    fillRightPage(back,next,false);
    fillLeftPage(leftPage,next,false);

  }

  sheet.append(front,back);
  sheet.setAttribute("aria-hidden","true");

  bookSpread.appendChild(sheet);

  let finished=false;

  function finish(){

    if(finished)return;

    finished=true;

    currentPage=next;

    sheet.remove();

    renderPage();

    pageTurning=false;

  }

  sheet.addEventListener(
    "animationend",finish,{once:true}
  );

  setTimeout(finish,1050);

}

let suppressClickUntil=0;

leftPage.addEventListener("click",()=>{

  if(Date.now()<suppressClickUntil)return;

  turnPage(-1);

});

rightPage.addEventListener("click",()=>{

  if(Date.now()<suppressClickUntil)return;

  turnPage(1);

});

[leftPage,rightPage].forEach((page,index)=>{

  page.addEventListener("keydown",event=>{

    if(event.target!==page)return;

    if(event.key==="Enter"||event.key===" "){

      event.preventDefault();

      turnPage(index===0?-1:1);

    }

  });

});

function bindSwipe(element,callback){

  let startX=0;
  let startY=0;

  element.addEventListener("touchstart",event=>{

    const touch=event.changedTouches[0];

    startX=touch.clientX;
    startY=touch.clientY;

  },{passive:true});

  element.addEventListener("touchend",event=>{

    const touch=event.changedTouches[0];

    const dx=touch.clientX-startX;
    const dy=touch.clientY-startY;

    if(Math.abs(dx)>50&&Math.abs(dx)>Math.abs(dy)){

      suppressClickUntil=Date.now()+500;

      callback(dx<0?1:-1);

    }

  },{passive:true});

}

